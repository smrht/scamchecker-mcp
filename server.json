{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "nl.scamchecker/scamchecker",
  "title": "Scamchecker.nl",
  "description": "Check a suspicious email, SMS, WhatsApp message or link for scam signals (Netherlands, Belgium).",
  "version": "1.1.0",
  "websiteUrl": "https://scamchecker.nl/",
  "repository": {
    "url": "https://github.com/smrht/scamchecker-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/smrht/scamchecker-mcp/main/logo-400.png",
      "mimeType": "image/png",
      "sizes": [
        "400x400"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://scamchecker.nl/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional: Bearer sc_... free API key from https://scamchecker.nl/api/sleutel/",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
